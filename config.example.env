# AI Skills — example configuration
#
# Copy to ~/.config/ai-skills/config.env and edit to match your project.
# Every variable is optional; skills fall back to sensible defaults when
# a variable is unset, and skip steps entirely when the relevant variable
# is empty.
#
#   mkdir -p ~/.config/ai-skills
#   cp config.example.env ~/.config/ai-skills/config.env
#   $EDITOR ~/.config/ai-skills/config.env

# ---------------------------------------------------------------------------
# MR / PR creation                                  (used by: finalize-branch)
# ---------------------------------------------------------------------------

# Tool used to open a merge/pull request.
#   "gh"   — GitHub CLI (default)
#   "glab" — GitLab CLI
export AI_SKILLS_MR_TOOL="gh"

# Comma-separated reviewer handles. Empty = no --reviewer flag is added.
export AI_SKILLS_REVIEWERS=""

# Target branch for new MRs/PRs.
export AI_SKILLS_TARGET_BRANCH="main"

# Ticket prefix used to gate the "Closes <TICKET>" line in MR descriptions.
# Empty = match any uppercase slug like FOO-123.
# Set to your project's prefix (e.g. "PROJ") to only match that one.
export AI_SKILLS_TICKET_PREFIX=""

# ---------------------------------------------------------------------------
# Docker test execution                 (used by: pytest-docker, rebase-on-main)
# ---------------------------------------------------------------------------

# Name of the docker-compose service that runs the backend / test container.
export AI_SKILLS_BACKEND_SERVICE="backend"

# ---------------------------------------------------------------------------
# Lint / format                                     (used by: rebase-on-main)
# ---------------------------------------------------------------------------

# Lint and format commands run after a rebase. Empty = skip that step.
# Example: "docker compose exec backend uv run poe lint"
export AI_SKILLS_LINT_CMD=""
export AI_SKILLS_FORMAT_CMD=""

# ---------------------------------------------------------------------------
# Alembic migrations                                (used by: rebase-on-main)
# ---------------------------------------------------------------------------

# Path to the alembic migrations directory, relative to the repo root.
# Empty = skip migration verification entirely.
# Example: "backend/src/myproject/infra/db/migrations"
export AI_SKILLS_MIGRATIONS_PATH=""

# Shell command that invokes `alembic` in your project's environment. The
# skill appends ` heads` or ` history` to this string.
# Empty = skip migration verification.
# Example: 'docker compose exec backend bash -c "cd /app/src/myproject/infra/db/migrations && uv run alembic"'
export AI_SKILLS_ALEMBIC_CMD=""
